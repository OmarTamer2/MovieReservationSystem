{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "aspmonster" : "ConnectionStringHere"
  },

  "JwtSettings": {
    "SecretKey": "TokenSecretAny64Bytestring",
